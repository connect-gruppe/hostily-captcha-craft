    "type": "craft-plugin",
    "license": "MIT",
    "version": "0.2.0",
    "homepage": "https://captcha.hostily.de",
    "keywords": ["craft", "craftcms", "craft-plugin", "captcha", "spam", "hostily", "formie", "freeform"],
    "require": {
